/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_TIM1_Init();
  MX_USART1_UART_Init();

  /* USER CODE BEGIN 2 */

  /* [BARU] Start ADC DMA: 9 channel (sebelumnya 6) */
  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_raw, 9);

  calibrate_imu();
  last_loop_tick = HAL_GetTick();

  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);
#if ENABLE_PID_CONTROL
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
#else
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 1);
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 1);
#endif
  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET);

#if ENABLE_UART_TRIGGER
  HAL_UART_Receive_IT(&huart1, rx_data_buf, 1);
#endif

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    /* Timing: tunggu hingga periode loop minimum tercapai,
     * lalu hitung dt aktual dari selisih tick real.
     */
      uint32_t now_tick;
      do
      {
          now_tick = HAL_GetTick();
      }
      while ((now_tick - last_loop_tick) < LOOP_DELAY_MS);

      dt = (now_tick - last_loop_tick) * 0.001f;
      if (dt < DT_MIN_S) dt = DT_MIN_S;
      if (dt > DT_MAX_S) dt = DT_MAX_S;
      last_loop_tick = now_tick;
      control_time_s += dt;

		  /* ============================================================
		   *  IMU 1 — HAND (adc_raw[0..2])
		   * ============================================================ */

		  float acc1_x_v  = adc_to_voltage(adc_raw[0]);
		  float gyro1_y_v = adc_to_voltage(adc_raw[1]);
		  float acc1_z_v  = adc_to_voltage(adc_raw[2]);

		  acc1_x  = acc_voltage_to_g(acc1_x_v - acc1_x_bias_v);
		  acc1_z  = acc_voltage_to_g(acc1_z_v - acc1_z_bias_v);
		  gyro1_y = gyro_voltage_to_dps(gyro1_y_v - gyro1_y_bias_v);

		  tilt1 = angle1_acc;           // dari accelerometer
		  gyro1_dps_out = gyro1_y_f;    // sudah dalam dps

	  #if USE_BUTTERWORTH_FILTER
		  acc1_x_f  = biquad_lpf_step(&lpf1_acc_x, acc1_x);
		  acc1_z_f  = biquad_lpf_step(&lpf1_acc_z, acc1_z);
		  gyro1_y_f = biquad_lpf_step(&lpf1_gyro_y, gyro1_y);
	  #else
		  acc1_x_f = acc1_x;
		  acc1_z_f = acc1_z;
		  gyro1_y_f = gyro1_y;
	  #endif

		  angle1_acc = atan2f(acc1_x_f, acc1_z_f) * RAD_TO_DEG - angle1_offset;
		  angle1_gyro += gyro1_y_f * dt;

	  #if USE_KALMAN_1D
		  angle1 = kalman_1d_update(&kf1, angle1_acc, gyro1_y_f, dt);
	  #else
		  angle1 = COMP_GYRO_WEIGHT * (angle1 + gyro1_y_f * dt)
				 + COMP_ACC_WEIGHT * angle1_acc;
	  #endif

		  /* ============================================================
		   *  IMU 2 — FOREARM (adc_raw[3..5])
		   * ============================================================ */

		  float acc2_x_v  = adc_to_voltage(adc_raw[3]);
		  float gyro2_y_v = adc_to_voltage(adc_raw[4]);
		  float acc2_z_v  = adc_to_voltage(adc_raw[5]);

		  acc2_x  = acc_voltage_to_g(acc2_x_v - acc2_x_bias_v);
		  acc2_z  = acc_voltage_to_g(acc2_z_v - acc2_z_bias_v);
		  gyro2_y = gyro_voltage_to_dps(gyro2_y_v - gyro2_y_bias_v);

		  tilt2 = angle2_acc;
		  gyro2_dps_out = gyro2_y_f;

	  #if USE_BUTTERWORTH_FILTER
		  acc2_x_f  = biquad_lpf_step(&lpf2_acc_x, acc2_x);
		  acc2_z_f  = biquad_lpf_step(&lpf2_acc_z, acc2_z);
		  gyro2_y_f = biquad_lpf_step(&lpf2_gyro_y, gyro2_y);
	  #else
		  acc2_x_f = acc2_x;
		  acc2_z_f = acc2_z;
		  gyro2_y_f = gyro2_y;
	  #endif

		  angle2_acc = atan2f(acc2_x_f, acc2_z_f) * RAD_TO_DEG - angle2_offset;
		  angle2_gyro += gyro2_y_f * dt;

	  #if USE_KALMAN_1D
		  angle2 = kalman_1d_update(&kf2, angle2_acc, gyro2_y_f, dt);
	  #else
		  angle2 = COMP_GYRO_WEIGHT * (angle2 + gyro2_y_f * dt)
				 + COMP_ACC_WEIGHT * angle2_acc;
	  #endif

		  /* ============================================================
		   *  IMU 3 — UPPER ARM / BICEP (adc_raw[6..8])
		   *
		   *  Sama persis pipeline-nya dengan IMU1 dan IMU2:
		   *    ADC → Voltage → Bias removal → g/dps → LPF → Angle
		   *
		   *  Channel mapping:
		   *    adc_raw[6] = ACC3_X  (accelerometer sumbu X)
		   *    adc_raw[7] = GYRO3_Y (gyroscope sumbu Y)
		   *    adc_raw[8] = ACC3_Z  (accelerometer sumbu Z)
		   * ============================================================ */

		  float acc3_x_v  = adc_to_voltage(adc_raw[6]);
		  float gyro3_y_v = adc_to_voltage(adc_raw[7]);
		  float acc3_z_v  = adc_to_voltage(adc_raw[8]);

		  acc3_x  = acc_voltage_to_g(acc3_x_v - acc3_x_bias_v);
		  acc3_z  = acc_voltage_to_g(acc3_z_v - acc3_z_bias_v);
		  gyro3_y = gyro_voltage_to_dps(gyro3_y_v - gyro3_y_bias_v);

		  tilt3 = angle3_acc;
		  gyro3_dps_out = gyro3_y_f;

	  #if USE_BUTTERWORTH_FILTER
		  acc3_x_f  = biquad_lpf_step(&lpf3_acc_x, acc3_x);
		  acc3_z_f  = biquad_lpf_step(&lpf3_acc_z, acc3_z);
		  gyro3_y_f = biquad_lpf_step(&lpf3_gyro_y, gyro3_y);
	  #else
		  acc3_x_f = acc3_x;
		  acc3_z_f = acc3_z;
		  gyro3_y_f = gyro3_y;
	  #endif

		  /* Sudut IMU3 dari accelerometer */
		  angle3_acc = atan2f(acc3_x_f, acc3_z_f) * RAD_TO_DEG - angle3_offset;

		  /* Integrasi gyroscope IMU3 */
		  angle3_gyro += gyro3_y_f * dt;

		  /* Sensor fusion IMU3 */
	  #if USE_KALMAN_1D
		  angle3 = kalman_1d_update(&kf3, angle3_acc, gyro3_y_f, dt);
	  #else
		  angle3 = COMP_GYRO_WEIGHT * (angle3 + gyro3_y_f * dt)
				 + COMP_ACC_WEIGHT * angle3_acc;
	  #endif

    #if ENABLE_AUTO_GYRO_REBIAS
      /* Re-bias gyro hanya jika semua IMU stabil selama beberapa detik. */
      if ((fabsf(gyro1_y_f) < AUTO_REBIAS_GYRO_TH_DPS) &&
        (fabsf(gyro2_y_f) < AUTO_REBIAS_GYRO_TH_DPS) &&
        (fabsf(gyro3_y_f) < AUTO_REBIAS_GYRO_TH_DPS))
      {
        if (stationary_since_tick == 0U)
        {
          stationary_since_tick = now_tick;
        }

        if ((now_tick - stationary_since_tick) >= AUTO_REBIAS_HOLD_MS)
        {
          gyro1_y_bias_v = ((1.0f - AUTO_REBIAS_ALPHA) * gyro1_y_bias_v) +
                   (AUTO_REBIAS_ALPHA * gyro1_y_v);
          gyro2_y_bias_v = ((1.0f - AUTO_REBIAS_ALPHA) * gyro2_y_bias_v) +
                   (AUTO_REBIAS_ALPHA * gyro2_y_v);
          gyro3_y_bias_v = ((1.0f - AUTO_REBIAS_ALPHA) * gyro3_y_bias_v) +
                   (AUTO_REBIAS_ALPHA * gyro3_y_v);
        }
      }
      else
      {
        stationary_since_tick = 0U;
      }
    #endif

		  /* ============================================================
		   *  HITUNG SUDUT SENDI
		   * ============================================================
		   *
		   *  WRIST (pergelangan tangan):
		   *    = angle_hand - angle_forearm
		   *    = angle1 - angle2
		   *    Positif = dorsiflexion, Negatif = palmar flexion
		   *
		   *  ELBOW (siku):
		   *    = angle_upperarm - angle_forearm
		   *    = angle3 - angle2
		   *    Positif = ekstensi (lurus), Negatif = fleksi (tekuk)
		   *
		   *    Catatan: tergantung orientasi sensor, mungkin perlu
		   *    balik tanda (ELBOW_SIGN = -1.0f) atau tukar
		   *    menjadi angle2 - angle3. Test dulu!
		   * ============================================================ */
		  wrist_joint_angle = WRIST_SIGN * (angle1 - angle2);
		  elbow_joint_angle = ELBOW_SIGN * (angle3 - angle2);   // cek dan pastikan

    #if ENABLE_LINEAR_GONIO_CAL
      wrist_joint_angle = (WRIST_CAL_A * wrist_joint_angle) + WRIST_CAL_B;
      elbow_joint_angle = (ELBOW_CAL_A * elbow_joint_angle) + ELBOW_CAL_B;
    #endif

    #if ENABLE_PID_CONTROL
      /* Setpoint trajectory (sinus) */
      /* Jalankan kontrol PID + FES hanya ketika sistem aktif.
       * Jika system_running == 0, PWM sudah di-set 0 oleh UART callback
       * (karakter 'g') sehingga FES aman dimatikan. */
      if (system_running)
      {
        /* ---- Setpoint trajectory ---- */
      wrist_setpoint_deg = WRIST_TRAJ_OFFSET_DEG;
      elbow_setpoint_deg = ELBOW_TRAJ_OFFSET_DEG;

	#if WRIST_TRAJ_ENABLE
		#if TRAJ_PATTERN_TYPE == 0
		wrist_setpoint_deg += WRIST_TRAJ_AMP_DEG *
			   sinf(TWO_PI * WRIST_TRAJ_FREQ_HZ * control_time_s);
		#else
		wrist_setpoint_deg = trapezoidal_wave(control_time_s,
											 WRIST_TRAJ_AMP_DEG,
											 WRIST_TRAJ_OFFSET_DEG);
		#endif
	#endif

     #if ELBOW_TRAJ_ENABLE
		#if TRAJ_PATTERN_TYPE == 0
				  elbow_setpoint_deg += ELBOW_TRAJ_AMP_DEG *
						  sinf(TWO_PI * ELBOW_TRAJ_FREQ_HZ * control_time_s);
				#else
				  elbow_setpoint_deg = trapezoidal_wave(control_time_s,
														ELBOW_TRAJ_AMP_DEG,
														ELBOW_TRAJ_OFFSET_DEG);
				#endif
      #endif

      /* Error berbasis sudut joint final (setelah kalibrasi jika enable) */
      wrist_err = wrist_setpoint_deg - wrist_joint_angle;
      elbow_err = elbow_setpoint_deg - elbow_joint_angle;

      wrist_err_int += wrist_err * dt;
      elbow_err_int += elbow_err * dt;

      if (wrist_err_int > PID_I_LIMIT) wrist_err_int = PID_I_LIMIT;
      if (wrist_err_int < -PID_I_LIMIT) wrist_err_int = -PID_I_LIMIT;
      if (elbow_err_int > PID_I_LIMIT) elbow_err_int = PID_I_LIMIT;
      if (elbow_err_int < -PID_I_LIMIT) elbow_err_int = -PID_I_LIMIT;

      float wrist_d = (wrist_err - wrist_err_prev) / dt;
      float elbow_d = (elbow_err - elbow_err_prev) / dt;

      wrist_pid_u = (WRIST_KP * wrist_err) + (WRIST_KI * wrist_err_int) +
                    (WRIST_KD * wrist_d);
      elbow_pid_u = (ELBOW_KP * elbow_err) + (ELBOW_KI * elbow_err_int) +
                    (ELBOW_KD * elbow_d);

      if (wrist_pid_u < PID_PWM_MIN) wrist_pid_u = PID_PWM_MIN;
      if (wrist_pid_u > PID_PWM_MAX) wrist_pid_u = PID_PWM_MAX;
      if (elbow_pid_u < PID_PWM_MIN) elbow_pid_u = PID_PWM_MIN;
      if (elbow_pid_u > PID_PWM_MAX) elbow_pid_u = PID_PWM_MAX;

      __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, (uint32_t)wrist_pid_u);
      __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, (uint32_t)elbow_pid_u);

      /* ---- FES Output (Fuzzy-PID atau PID murni) ---- */
           #if ENABLE_FUZZY_CONTROL
             /* Hitung kecepatan sudut sendi dari diferensial sudut joint per dt.
              * Ini lebih representatif dari raw gyro karena mencerminkan gerakan
              * sendi relatif (bukan gerakan absolut satu IMU). */
             wrist_joint_vel = (wrist_joint_angle - wrist_joint_angle_prev) / dt;
             elbow_joint_vel = (elbow_joint_angle - elbow_joint_angle_prev) / dt;
             wrist_joint_angle_prev = wrist_joint_angle;
             elbow_joint_angle_prev = elbow_joint_angle;

             /* Hitung Fuzzy ICA per joint dengan parameter MF yang dikonfigurasi
              * terpisah untuk wrist dan elbow via macro WRIST/ELBOW_FUZZY_*. */
             wrist_fuzzy_ica = compute_fuzzy_ica(
                 wrist_joint_vel, wrist_joint_angle,
                 WRIST_FUZZY_ANG_LOW,  WRIST_FUZZY_ANG_MED,
                 WRIST_FUZZY_ANG_HIGH, WRIST_FUZZY_ANG_WIDTH,
                 WRIST_FUZZY_VEL_LOW,  WRIST_FUZZY_VEL_MED,
                 WRIST_FUZZY_VEL_HIGH, WRIST_FUZZY_VEL_WIDTH);

             elbow_fuzzy_ica = compute_fuzzy_ica(
                 elbow_joint_vel, elbow_joint_angle,
                 ELBOW_FUZZY_ANG_LOW,  ELBOW_FUZZY_ANG_MED,
                 ELBOW_FUZZY_ANG_HIGH, ELBOW_FUZZY_ANG_WIDTH,
                 ELBOW_FUZZY_VEL_LOW,  ELBOW_FUZZY_VEL_MED,
                 ELBOW_FUZZY_VEL_HIGH, ELBOW_FUZZY_VEL_WIDTH);

             /* Gabungkan Fuzzy ICA + PID */
             wrist_fes_duty = compute_fuzzy_intensity(wrist_fuzzy_ica, wrist_pid_u);
             elbow_fes_duty = compute_fuzzy_intensity(elbow_fuzzy_ica, elbow_pid_u);

             if (wrist_fes_duty < PID_PWM_MIN) wrist_fes_duty = PID_PWM_MIN;
             if (wrist_fes_duty > PID_PWM_MAX) wrist_fes_duty = PID_PWM_MAX;
             if (elbow_fes_duty < PID_PWM_MIN) elbow_fes_duty = PID_PWM_MIN;
             if (elbow_fes_duty > PID_PWM_MAX) elbow_fes_duty = PID_PWM_MAX;

             __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, (uint32_t)wrist_fes_duty);
             __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, (uint32_t)elbow_fes_duty);
           #else
             __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, (uint32_t)wrist_pid_u);
             __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, (uint32_t)elbow_pid_u);
           #endif

           wrist_err_prev = wrist_err;
           elbow_err_prev = elbow_err;
         }
         /* system_running == 0: PWM sudah di-set 0 oleh UART callback */
         #endif

		  /* ============================================================
		   *  KIRIM DATA CSV VIA UART (15 kolom)
		   * ============================================================
		   * KIRIM DATA CSV VIA UART
		   *
		   *  Kolom  0-2  : adc_raw IMU1 (hand)
		   *  Kolom  3-5  : adc_raw IMU2 (forearm)
		   *  Kolom  6-8  : adc_raw IMU3 (upper arm)    [BARU]
		   *  Kolom  9    : angle1 (sudut fused hand)
		   *  Kolom  10   : angle2 (sudut fused forearm)
		   *  Kolom  11   : angle3 (sudut fused upper arm) [BARU]
		   *  Kolom  12   : wrist_joint_angle (opsional setelah y=ax+b)
		   *  Kolom  13   : elbow_joint_angle (opsional setelah y=ax+b)
		   *  Kolom  14   : (reserved, 0 untuk sekarang)
		   *  Format CSV (27 kolom):
		   *  Kolom  1-6  : IMU1 (acc_x, acc_z, gyro_y, tilt, gyro_dps, angle)
		   *  Kolom  7-12 : IMU2 (sama)
		   *  Kolom 13-18 : IMU3 (sama)
		   *  Kolom 19-20 : Sudut sendi (wrist, elbow)
		   *  Kolom 21-23 : Wrist control (setpoint, error, pid_u)
		   *  Kolom 24-26 : Elbow control (setpoint, error, pid_u)
		   *  Kolom 27    : system_running flag
		   * ============================================================ */

//		  sprintf(uart_buf,
//				  "%u,%u,%u,%u,%u,%u,%u,%u,%u,"
//				  "%.3f,%.3f,%.3f,"
//				  "%.3f,%.3f,%.3f\r\n",
//				  /* Kolom 0-8: ADC raw semua 9 channel */
//				  adc_raw[0], adc_raw[1], adc_raw[2],
//				  adc_raw[3], adc_raw[4], adc_raw[5],
//				  adc_raw[6], adc_raw[7], adc_raw[8],
//				  /* Kolom 9-11: Sudut fused per IMU */
//				  angle1, angle2, angle3,
//				  /* Kolom 12-14: Sudut sendi + reserved */
//          wrist_joint_angle,
//          elbow_joint_angle,
//				  0.0f);   /* reserved untuk nanti */
//
//		  HAL_UART_Transmit(&huart1,
//							(uint8_t*)uart_buf,
//							strlen(uart_buf),
//							50);
		  sprintf(uart_buf,
		      /* IMU1 */
		      "%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,"
		      /* IMU2 */
		      "%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,"
		      /* IMU3 */
		      "%.3f,%.3f,%.3f,%.3f,%.3f,%.3f,"
			  /* Joint angles */
			  "%.3f,%.3f,"
			  /* Wrist control */
			  "%.3f,%.3f,%.3f,"
			  /* Elbow control */
			  "%.3f,%.3f,%.3f,"
			  /* Status */
			  "%u\r\n",

		      /* IMU1 */
		      acc1_x_f, acc1_z_f, gyro1_y_f,
		      tilt1, gyro1_dps_out, angle1,

		      /* IMU2 */
		      acc2_x_f, acc2_z_f, gyro2_y_f,
		      tilt2, gyro2_dps_out, angle2,

		      /* IMU3 */
		      acc3_x_f, acc3_z_f, gyro3_y_f,
		      tilt3, gyro3_dps_out, angle3,

			  /* Joint angles */
		      wrist_joint_angle,
			  elbow_joint_angle,

			  		      /* Wrist control */
			  		      wrist_setpoint_deg, wrist_err, wrist_pid_u,

			  		      /* Elbow control */
			  		      elbow_setpoint_deg, elbow_err, elbow_pid_u,

			  		      /* Status */
			  		      (unsigned)system_running
			  		  );

			  		  HAL_UART_Transmit(&huart1,
			  		                    (uint8_t*)uart_buf,
			  		                    strlen(uart_buf),
