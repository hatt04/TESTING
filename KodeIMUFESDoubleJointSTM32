/* Fungsi konversi */
float adc_to_voltage(uint16_t adc)
{
	return (adc * 3.3f) / 4095.0f;
}

float acc_voltage_to_g(float v)
{
	return v / ACC_SENS_V_PER_G;
}

float gyro_voltage_to_dps(float v)
{
	return v / GYRO_SENS_V_PER_DPS;
}

/* Biquad LPF */
float biquad_lpf_step(BiquadLPFState *s, float input)
{
    float out = (BQ_A1 * s->y1) - (BQ_A2 * s->y2)
              + (BQ_B0 * input) + (BQ_B1 * s->x1) + (BQ_B2 * s->x2);
    s->x2 = s->x1; s->x1 = input;
    s->y2 = s->y1; s->y1 = out;
    return out;
}

void biquad_lpf_reset(BiquadLPFState *s)
{
    s->x1 = 0; s->x2 = 0; s->y1 = 0; s->y2 = 0;
}

/* Kalman */
float kalman_1d_update(Kalman1DState *kf, float angle_meas, float gyro_rate_dps, float dt_s)
{
    float rate = gyro_rate_dps - kf->bias;
    kf->angle += rate * dt_s;
    kf->p00 += dt_s * (dt_s * kf->p11 - kf->p01 - kf->p10 + KALMAN_Q_ANGLE);
    kf->p01 -= dt_s * kf->p11;
    kf->p10 -= dt_s * kf->p11;
    kf->p11 += KALMAN_Q_GYRO * dt_s;
    float innovation = angle_meas - kf->angle;
    float s = kf->p00 + KALMAN_R_ANGLE;
    if (s < 1.0e-6f) s = 1.0e-6f;
    float k0 = kf->p00 / s;
    float k1 = kf->p10 / s;
    kf->angle += k0 * innovation;
    kf->bias += k1 * innovation;
    float p00_tmp = kf->p00, p01_tmp = kf->p01;
    kf->p00 -= k0 * p00_tmp;
    kf->p01 -= k0 * p01_tmp;
    kf->p10 -= k1 * p00_tmp;
    kf->p11 -= k1 * p01_tmp;
    return kf->angle;
}

void kalman_1d_reset(Kalman1DState *kf, float init_angle)
{
    kf->angle = init_angle;
    kf->bias = 0.0f;
    kf->p00 = 1.0f;
    kf->p01 = 0.0f;
    kf->p10 = 0.0f;
    kf->p11 = 1.0f;
}

/* ================================================================
 *  KALIBRASI 3 IMU
 *
 *  Perubahan dari versi 2 IMU:
 *    - Tambah akumulasi gyro3 bias
 *    - Tambah akumulasi angle3 offset
 *    - Tambah reset variabel IMU3
 *    - Tambah reset filter IMU3 (LPF + Kalman)
 * ================================================================ */
void calibrate_imu(void)
{
    float sum_gyro1_y_v = 0, sum_gyro2_y_v = 0, sum_gyro3_y_v = 0;
    float sum_angle1 = 0, sum_angle2 = 0, sum_angle3 = 0;
    uint32_t samples = 0;
    uint32_t t0 = HAL_GetTick();

    HAL_Delay(500);

    while ((HAL_GetTick() - t0) < CALIB_DURATION_MS)
    {
        /* Akumulasi bias gyroscope */
        sum_gyro1_y_v += adc_to_voltage(adc_raw[1]);
        sum_gyro2_y_v += adc_to_voltage(adc_raw[4]);
        sum_gyro3_y_v += adc_to_voltage(adc_raw[7]);   /* [BARU] */

        /* Hitung sudut accelerometer untuk offset */
        float a1x = acc_voltage_to_g(adc_to_voltage(adc_raw[0]) - ACC_ZERO_G_V);
        float a1z = acc_voltage_to_g(adc_to_voltage(adc_raw[2]) - ACC_ZERO_G_V);
        float a2x = acc_voltage_to_g(adc_to_voltage(adc_raw[3]) - ACC_ZERO_G_V);
        float a2z = acc_voltage_to_g(adc_to_voltage(adc_raw[5]) - ACC_ZERO_G_V);
        float a3x = acc_voltage_to_g(adc_to_voltage(adc_raw[6]) - ACC_ZERO_G_V);   /* [BARU] */
        float a3z = acc_voltage_to_g(adc_to_voltage(adc_raw[8]) - ACC_ZERO_G_V);   /* [BARU] */

        sum_angle1 += atan2f(a1x, a1z) * RAD_TO_DEG;
        sum_angle2 += atan2f(a2x, a2z) * RAD_TO_DEG;
        sum_angle3 += atan2f(a3x, a3z) * RAD_TO_DEG;   /* [BARU] */

        samples++;
        HAL_Delay(5);
    }

    if (samples == 0U) samples = 1U;
    float inv = 1.0f / (float)samples;

    /* IMU1 bias */
    acc1_x_bias_v  = ACC_ZERO_G_V;
    acc1_z_bias_v  = ACC_ZERO_G_V;
    gyro1_y_bias_v = sum_gyro1_y_v * inv;

    /* IMU2 bias */
    acc2_x_bias_v  = ACC_ZERO_G_V;
    acc2_z_bias_v  = ACC_ZERO_G_V;
    gyro2_y_bias_v = sum_gyro2_y_v * inv;

    /* [BARU] IMU3 bias */
    acc3_x_bias_v  = ACC_ZERO_G_V;
    acc3_z_bias_v  = ACC_ZERO_G_V;
    gyro3_y_bias_v = sum_gyro3_y_v * inv;

    /* Offset sudut awal */
    angle1_offset = sum_angle1 * inv;
    angle2_offset = sum_angle2 * inv;
    angle3_offset = sum_angle3 * inv;   /* [BARU] */

    /* Reset semua variabel sudut */
    angle1 = 0; angle2 = 0; angle3 = 0;   /* [BARU] angle3 */
    angle1_gyro = 0; angle2_gyro = 0; angle3_gyro = 0;   /* [BARU] */
    wrist_joint_angle = 0;
    elbow_joint_angle = 0;   /* [BARU] */

    control_time_s = 0.0f;
    wrist_setpoint_deg = 0.0f;
    elbow_setpoint_deg = 0.0f;
    wrist_err = 0.0f; wrist_err_prev = 0.0f; wrist_err_int = 0.0f;
    elbow_err = 0.0f; elbow_err_prev = 0.0f; elbow_err_int = 0.0f;
    wrist_pid_u = 0.0f;
    elbow_pid_u = 0.0f;


#if ENABLE_FUZZY_CONTROL
    wrist_joint_angle_prev = 0.0f;
    elbow_joint_angle_prev = 0.0f;
    wrist_joint_vel = 0.0f;
    elbow_joint_vel = 0.0f;
#endif

    /* Reset filtered values */
    acc1_x_f = 0; acc1_z_f = 0; gyro1_y_f = 0;
    acc2_x_f = 0; acc2_z_f = 0; gyro2_y_f = 0;
    acc3_x_f = 0; acc3_z_f = 0; gyro3_y_f = 0;   /* [BARU] */

    /* Reset Biquad LPF */
    biquad_lpf_reset(&lpf1_acc_x);
    biquad_lpf_reset(&lpf1_acc_z);
    biquad_lpf_reset(&lpf1_gyro_y);
    biquad_lpf_reset(&lpf2_acc_x);
    biquad_lpf_reset(&lpf2_acc_z);
    biquad_lpf_reset(&lpf2_gyro_y);
    biquad_lpf_reset(&lpf3_acc_x);    /* [BARU] */
    biquad_lpf_reset(&lpf3_acc_z);    /* [BARU] */
    biquad_lpf_reset(&lpf3_gyro_y);   /* [BARU] */

    /* Reset Kalman */
    kalman_1d_reset(&kf1, 0.0f);
    kalman_1d_reset(&kf2, 0.0f);
    kalman_1d_reset(&kf3, 0.0f);   /* [BARU] */

    /* Reset state auto re-bias gyro */
    stationary_since_tick = 0U;

    /* ================================================================
     *  [BARU] TRAPEZOIDAL WAVE GENERATOR
     *
     *  Menghasilkan gelombang trapesium periodik dengan:
     *    - Fase naik   (T_RISE) : ramp dari offset ke offset+amp
     *    - Fase puncak (T_PEAK) : tahan di offset+amp
     *    - Fase turun  (T_FALL) : ramp dari offset+amp ke offset
     *    - Fase dasar  (T_BASE) : tahan di offset (fase istirahat otot)
     * ================================================================ */
    #if TRAJ_PATTERN_TYPE == 1
    float trapezoidal_wave(float time_s, float amp, float offset)
    {
        float t_mod = fmodf(time_s, T_TOTAL);
        if (t_mod < T_RISE) {
            return (amp / T_RISE) * t_mod + offset;
        } else if (t_mod < (T_RISE + T_PEAK)) {
            return amp + offset;
        } else if (t_mod < (T_RISE + T_PEAK + T_FALL)) {
            return amp - (amp / T_FALL) * (t_mod - (T_RISE + T_PEAK)) + offset;
        } else {
            return offset;
        }
    }
    #endif

    /* ================================================================
     *  [BARU] FUZZY LOGIC — Membership Functions & Rule Base
     *
     *  Port dari KodeKatingIMUSingleJoint, direfaktor menjadi modular
     *  sehingga bisa dipanggil terpisah untuk Wrist maupun Elbow.
     *
     *  Referensi:
     *    lefttrap / triangle_mf / righttrap : fungsi membership
     *    compute_fuzzy_ica()  : fuzzifikasi + rule base + defuzzifikasi
     *    compute_fuzzy_intensity() : kombinasi ICA + PID → duty FES
     * ================================================================ */
    #if ENABLE_FUZZY_CONTROL

    /* Left trapezoid membership function
     *   Nilai 1 untuk x <= a, turun linear ke 0 di x = a + b/2 */
    float lefttrap(float a, float b, float x)
    {
        if (x <= a) return 1.0f;
        if (x <= a + b / 2.0f) return 1.0f - 2.0f * fabsf(x - a) / b;
        return 0.0f;
    }

    /* Triangle membership function
     *   Puncak 1 di x = a, turun ke 0 di x = a ± b/2 */
    float triangle_mf(float a, float b, float x)
    {
        if (x >= a - b / 2.0f && x <= a + b / 2.0f)
            return 1.0f - 2.0f * fabsf(x - a) / b;
        return 0.0f;
    }

    /* Right trapezoid membership function
     *   Naik dari 0 di x = a - b/2 menuju 1 untuk x >= a
     *   Note: denominator 2*b (bukan b) mempertahankan perilaku asli kode kating. */
    float righttrap(float a, float b, float x)
    {
        if (x >= a) return 1.0f;
        if (x >= a - b / 2.0f) return 1.0f - 2.0f * fabsf(x - a) / (2.0f * b);
        return 0.0f;
    }

    /* Internal defuzzification helper (centroid method) */
    #define DEFUZZ_EPSILON 1.0e-6f   /* threshold to avoid division by near-zero */
    static float _defuzzify(float aggregated[], float out_range[], int n)
    {
        float numerator = 0.0f, denominator = 0.0f;
        int i;
        for (i = 0; i < n; i++) {
            numerator   += aggregated[i] * out_range[i];
            denominator += aggregated[i];
        }
        if (denominator < DEFUZZ_EPSILON) return 0.0f;
        return numerator / denominator;
    }

    /*
     * compute_fuzzy_ica()
     *   velocity : kecepatan sudut sendi (deg/s), dari d(joint_angle)/dt
     *   angle    : sudut sendi saat ini (deg)
     *   ang_a/b/c: center membership function Low/Med/High untuk angle
     *   ang_w    : lebar (width) membership function angle
     *   vel_a/b/c: center membership function Low/Med/High untuk velocity
     *   vel_w    : lebar (width) membership function velocity
     *   return   : ICA (Intended Cognitive Activity) — range 0..~1
     *
     *  Rule base 3×3 (angle: Low/Med/High, velocity: Low/Med/High):
     *    ang_Low  + vel_Low  → output HIGH
     *    ang_Low  + vel_Med  → output MED
     *    ang_Low  + vel_High → output MED
     *    ang_Med  + vel_Low  → output LOW
     *    ang_Med  + vel_Med  → output MED
     *    ang_Med  + vel_High → output HIGH
     *    ang_High + vel_Low  → output MED
     *    ang_High + vel_Med  → output HIGH
     *    ang_High + vel_High → output HIGH
     */
    float compute_fuzzy_ica(float velocity, float angle,
                            float ang_a, float ang_b, float ang_c, float ang_w,
                            float vel_a, float vel_b, float vel_c, float vel_w)
    {
        float miu_ang[3], miu_vel[3];
        float u_ica[3] = {0.0f, 0.0f, 0.0f};
        float out_mf[3][20];
        float aggregated_output[20] = {0};
        float out_range[20];
        float temp_ica;
        int i, j;

        /* Fuzzifikasi sudut — menggunakan parameter per-joint */
        miu_ang[0] = lefttrap(ang_a, ang_w, angle);
        miu_ang[1] = triangle_mf(ang_b, ang_w, angle);
        miu_ang[2] = righttrap(ang_c, ang_w, angle);

        /* Fuzzifikasi kecepatan — menggunakan parameter per-joint */
        miu_vel[0] = lefttrap(vel_a, vel_w, velocity);
        miu_vel[1] = triangle_mf(vel_b, vel_w, velocity);
        miu_vel[2] = righttrap(vel_c, vel_w, velocity);

        /* Rule base */
        /* 1. ang_Low + vel_Low → HIGH */
        temp_ica = 0.0f;
        if (miu_ang[0] > 0.0f && miu_vel[0] > 0.0f)
            temp_ica = fminf(miu_ang[0], miu_vel[0]);
        u_ica[2] = fmaxf(u_ica[2], temp_ica);

        /* 2. ang_Low + vel_Med → MED */
        temp_ica = 0.0f;
        if (miu_ang[0] > 0.0f && miu_vel[1] > 0.0f)
            temp_ica = fminf(miu_ang[0], miu_vel[1]);
        u_ica[1] = fmaxf(u_ica[1], temp_ica);

        /* 3. ang_Low + vel_High → MED */
        temp_ica = 0.0f;
        if (miu_ang[0] > 0.0f && miu_vel[2] > 0.0f)
            temp_ica = fminf(miu_ang[0], miu_vel[2]);
        u_ica[1] = fmaxf(u_ica[1], temp_ica);

        /* 4. ang_Med + vel_Low → LOW */
        temp_ica = 0.0f;
        if (miu_ang[1] > 0.0f && miu_vel[0] > 0.0f)
            temp_ica = fminf(miu_ang[1], miu_vel[0]);
        u_ica[0] = fmaxf(u_ica[0], temp_ica);

        /* 5. ang_Med + vel_Med → MED */
        temp_ica = 0.0f;
        if (miu_ang[1] > 0.0f && miu_vel[1] > 0.0f)
            temp_ica = fminf(miu_ang[1], miu_vel[1]);
        u_ica[1] = fmaxf(u_ica[1], temp_ica);

        /* 6. ang_Med + vel_High → HIGH */
        temp_ica = 0.0f;
        if (miu_ang[1] > 0.0f && miu_vel[2] > 0.0f)
            temp_ica = fminf(miu_ang[1], miu_vel[2]);
        u_ica[2] = fmaxf(u_ica[2], temp_ica);

        /* 7. ang_High + vel_Low → MED */
        temp_ica = 0.0f;
        if (miu_ang[2] > 0.0f && miu_vel[0] > 0.0f)
            temp_ica = fminf(miu_ang[2], miu_vel[0]);
        u_ica[1] = fmaxf(u_ica[1], temp_ica);

        /* 8. ang_High + vel_Med → HIGH */
        temp_ica = 0.0f;
        if (miu_ang[2] > 0.0f && miu_vel[1] > 0.0f)
            temp_ica = fminf(miu_ang[2], miu_vel[1]);
        u_ica[2] = fmaxf(u_ica[2], temp_ica);

        /* 9. ang_High + vel_High → HIGH */
        temp_ica = 0.0f;
        if (miu_ang[2] > 0.0f && miu_vel[2] > 0.0f)
            temp_ica = fminf(miu_ang[2], miu_vel[2]);
        u_ica[2] = fmaxf(u_ica[2], temp_ica);

        /* Output membership functions (range 0 → 2.0) */
        for (i = 0; i < 20; i++) {
            out_range[i] = (float)i / 10.0f;
            out_mf[0][i] = lefttrap(0.6f, 0.4f, out_range[i]);
            out_mf[1][i] = triangle_mf(1.0f, 0.4f, out_range[i]);
            out_mf[2][i] = righttrap(1.4f, 0.4f, out_range[i]);
        }

        /* Agregasi output */
        for (i = 0; i < 20; i++) {
            for (j = 0; j < 3; j++) {
                aggregated_output[i] = fmaxf(aggregated_output[i],
                                             fminf(u_ica[j], out_mf[j][i]));
            }
        }

        /* Defuzzifikasi (centroid) → ICA dinormalisasi × 0.5 */
        float ica = _defuzzify(aggregated_output, out_range, 20);
        return ica * 0.5f;
    }

    /*
     * compute_fuzzy_intensity()
     *   ica   : Fuzzy ICA dari compute_fuzzy_ica()
     *   pid_u : PID output (sudah ter-clamp di [PID_PWM_MIN, PID_PWM_MAX])
     *   return: Combined FES duty ≥ 0
     *
     *  Rumus:  duty = (FUZZY_WEIGHT_CA × ica) + (FUZZY_WEIGHT_FDBK × pid_u/2)
     *  Sesuai formula duty.if_ dari kode asli kating.
     */
    float compute_fuzzy_intensity(float ica, float pid_u)
    {
        float duty = (FUZZY_WEIGHT_CA * ica) + (FUZZY_WEIGHT_FDBK * (pid_u / 2.0f));
        if (duty < 0.0f) duty = 0.0f;
        return duty;
    }

    #endif /* ENABLE_FUZZY_CONTROL */

    /* ================================================================
     *  [BARU] UART TRIGGER CALLBACK
     *
     *  Karakter 'd' → mulai FES (system_running = 1)
     *  Karakter 'g' → stop  FES (system_running = 0, PWM = 0)
     * ================================================================ */
    #if ENABLE_UART_TRIGGER
    void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
    {
        if (huart->Instance == USART1) {
            if (rx_data_buf[0] == 'd') {
                system_running = 1;
            } else if (rx_data_buf[0] == 'g') {
                system_running = 0;
                __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
                __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
            }
            HAL_UART_Receive_IT(&huart1, rx_data_buf, 1);
        }
    }
    #endif

}

